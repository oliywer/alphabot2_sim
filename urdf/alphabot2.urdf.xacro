<?xml version="1.0"?>
<!--
  Waveshare AlphaBot2-Pi – digital twin for Gazebo Harmonic (ROS 2 Jazzy)
  Dimensions are approximate; tune them to the real robot (measure it!).
  - differential drive, 2x N20 motors, wheels D=42 mm, W=19 mm
  - 2 DOF pan-tilt camera (2x SG90 + RPi Camera B)
  - optional virtual 2D lidar (NOT on the real robot) for SLAM / Nav2 in simulation
-->
<robot name="alphabot2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_lidar" default="true"/>

  <xacro:property name="PI" value="3.14159265"/>
  <xacro:property name="wheel_radius" value="0.021"/>
  <xacro:property name="wheel_width" value="0.019"/>
  <xacro:property name="wheel_separation" value="0.096"/>
  <xacro:property name="chassis_radius" value="0.055"/>
  <xacro:property name="chassis_height" value="0.040"/>
  <xacro:property name="chassis_z" value="0.012"/>
  <xacro:property name="caster_radius" value="0.0105"/>
  <xacro:property name="chassis_top" value="${chassis_z + chassis_height/2}"/>

  <!-- ===== inertia helpers ===== -->
  <xacro:macro name="cyl_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/>
  </xacro:macro>
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>
  <xacro:macro name="sphere_inertia" params="m r">
    <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0"
             iyy="${2*m*r*r/5}" iyz="0" izz="${2*m*r*r/5}"/>
  </xacro:macro>

  <material name="blue"><color rgba="0.10 0.30 0.70 1"/></material>
  <material name="black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="grey"><color rgba="0.60 0.60 0.60 1"/></material>
  <material name="green"><color rgba="0.10 0.50 0.20 1"/></material>

  <!-- ===== chassis ===== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z}"/>
      <geometry><cylinder radius="${chassis_radius}" length="${chassis_height}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z}"/>
      <geometry><cylinder radius="${chassis_radius}" length="${chassis_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_z}"/>
      <mass value="0.35"/>
      <xacro:cyl_inertia m="0.35" r="${chassis_radius}" h="${chassis_height}"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <!-- ===== drive wheels ===== -->
  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel">
      <visual>
        <origin rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <!-- sphere collision: single, stable ground contact in DART (cylinder wheels slip on turns) -->
      <collision>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
      </collision>
      <inertial>
        <origin rpy="${PI/2} 0 0"/>
        <mass value="0.03"/>
        <xacro:cyl_inertia m="0.03" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${y} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${side}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel side="left" y="${wheel_separation/2}"/>
  <xacro:wheel side="right" y="${-wheel_separation/2}"/>

  <!-- ===== passive ball casters (front + rear) ===== -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.01"/>
        <xacro:sphere_inertia m="0.01" r="${caster_radius}"/>
      </inertial>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster"/>
      <!-- 0.5 mm above ground: casters only stabilise, wheels carry the load -->
      <origin xyz="${x} 0 ${caster_radius - wheel_radius + 0.0005}"/>
    </joint>
    <gazebo reference="${name}_caster_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <gazebo reference="${name}_caster">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="front" x="0.040"/>
  <xacro:caster name="rear" x="-0.040"/>

  <!-- ===== pan-tilt camera ===== -->
  <link name="pan_link">
    <visual>
      <origin xyz="0 0 0.006"/>
      <geometry><box size="0.024 0.024 0.012"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.006"/>
      <geometry><box size="0.024 0.024 0.012"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.006"/>
      <mass value="0.02"/>
      <xacro:box_inertia m="0.02" x="0.024" y="0.024" z="0.012"/>
    </inertial>
  </link>

  <joint name="pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="pan_link"/>
    <origin xyz="0.030 0 ${chassis_top}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-PI/2}" upper="${PI/2}" effort="1.0" velocity="4.0"/>
    <dynamics damping="0.001"/>
  </joint>

  <link name="tilt_link">
    <visual>
      <geometry><box size="0.012 0.030 0.026"/></geometry>
      <material name="green"/>
    </visual>
    <collision>
      <geometry><box size="0.012 0.030 0.026"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <xacro:box_inertia m="0.02" x="0.012" y="0.030" z="0.026"/>
    </inertial>
  </link>

  <joint name="tilt_joint" type="revolute">
    <parent link="pan_link"/>
    <child link="tilt_link"/>
    <origin xyz="0 0 0.026"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI/3}" upper="${PI/3}" effort="1.0" velocity="4.0"/>
    <dynamics damping="0.001"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="0.005" length="0.006"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="tilt_link"/>
    <child link="camera_link"/>
    <origin xyz="0.009 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>/camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera>
        <camera_info_topic>/camera/camera_info</camera_info_topic>
        <horizontal_fov>0.94</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>20.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ===== optional virtual lidar (simulation only) ===== -->
  <xacro:if value="$(arg use_lidar)">
    <link name="lidar_link">
      <visual>
        <geometry><cylinder radius="0.018" length="0.018"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="0.018" length="0.018"/></geometry>
      </collision>
      <inertial>
        <mass value="0.02"/>
        <xacro:cyl_inertia m="0.02" r="0.018" h="0.018"/>
      </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_link"/>
      <origin xyz="-0.020 0 ${chassis_top + 0.012}"/>
    </joint>

    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.08</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- ===== Gazebo systems ===== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>6.0</max_angular_acceleration>
      <min_angular_acceleration>-6.0</min_angular_acceleration>
      <max_linear_velocity>0.4</max_linear_velocity>
      <min_linear_velocity>-0.4</min_linear_velocity>
      <max_angular_velocity>4.0</max_angular_velocity>
      <min_angular_velocity>-4.0</min_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>pan_joint</joint_name>
      <topic>/pan_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>6.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.0</d_gain>
      <cmd_max>4.0</cmd_max>
      <cmd_min>-4.0</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>tilt_joint</joint_name>
      <topic>/tilt_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>6.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.0</d_gain>
      <cmd_max>4.0</cmd_max>
      <cmd_min>-4.0</cmd_min>
    </plugin>
  </gazebo>

</robot>
