<?xml version="1.0"?>
<sdf version="1.9">
  <world name="alphabot2_maze">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <model name="maze">
      <static>true</static>
      <link name="wall_n">
        <pose>0 1.5 0.125 0 0 0</pose>
        <collision name="c"><geometry><box><size>3.05 0.05 0.25</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.05 0.05 0.25</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
      </link>
      <link name="wall_s">
        <pose>0 -1.5 0.125 0 0 0</pose>
        <collision name="c"><geometry><box><size>3.05 0.05 0.25</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.05 0.05 0.25</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
      </link>
      <link name="wall_e">
        <pose>1.5 0 0.125 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.05 3.05 0.25</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 3.05 0.25</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
      </link>
      <link name="wall_w">
        <pose>-1.5 0 0.125 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.05 3.05 0.25</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 3.05 0.25</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
      </link>
      <link name="inner_1">
        <pose>-0.5 0.6 0.125 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.05 1.8 0.25</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 1.8 0.25</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
      </link>
      <link name="inner_2">
        <pose>0.6 -0.6 0.125 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.8 0.05 0.25</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.8 0.05 0.25</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
      </link>
      <link name="box_1">
        <pose>0.9 0.8 0.125 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.25 0.25 0.25</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.25 0.25 0.25</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
      </link>
      <link name="box_2">
        <pose>-0.9 -0.9 0.125 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 0.35 0.25</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 0.35 0.25</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
